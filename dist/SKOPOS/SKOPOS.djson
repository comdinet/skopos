              "Formula": {
                "Expression": "function N(k, d) { var v = parseFloat($prop(k)); return isNaN(v) ? d : v; }\nfunction TN(k, d) { return N('DataCorePlugin.GameRawData.Telemetry.' + k, d); }\nfunction trackT() { var v = N('RoadTemperature', null); return v === null ? TN('TrackTempCrew', null) : v; }\nfunction trend(key, v, win) {\n  if (v === null || typeof root === 'undefined') { return null; }\n  var now = new Date().getTime() / 1000;\n  if (!root[key]) { root[key] = []; }\n  var a = root[key];\n  if (a.length === 0 || now - a[a.length - 1][0] >= 20) { a.push([now, v]); }\n  while (a.length > 2 && now - a[1][0] > win) { a.shift(); }\n  if (a.length < 2 || now - a[0][0] < 60) { return null; }\n  return v - a[0][1];\n}\nvar v = trackT(); var d = trend('tt', v, 600); if (d === null) { return 'collecting trend…'; } if (Math.abs(d) < 0.25) { return 'steady over last 10 min'; } return (d > 0 ? '▲ ' : '▼ ') + Math.abs(d).toFixed(1) + '° over last 10 min';",
