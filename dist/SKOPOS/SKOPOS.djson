 { t++; } } var sof = sofCalc(), hid = Math.max(0, ft.length - 24); return ft.length + ' cars  ·  ' + t + ' with a time' + (hid ? '  ·  ' + hid + ' hidden' : '') + (sof ? '  ·  SoF ' + sof : '');",
