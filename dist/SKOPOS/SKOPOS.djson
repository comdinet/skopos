                "Expression": "function nz(v, d) { return (v === null || v === undefined || v === '' || (typeof v === 'number' && isNaN(v))) ? d : v; }\nfunction P(k, d) { return nz($prop(k), d); }\nfunction N(k, d) { var v = parseFloat($prop(k)); return isNaN(v) ? d : v; }\nfunction B(k) { var v = $prop(k); return v === true || v === 'True' || v === 'true' || (typeof v === 'number' && v > 0) || v === '1'; }\nfunction S(k, d) { return P('DataCorePlugin.GameRawData.SessionData.' + k, d); }\nfunction XN(k, d) { return N('IRacingExtraProperties.iRacing_' + k, d); }\nfunction unitNum(s) { if (s === null || s === undefined) { return null; } var v = parseFloat(('' + s).replace(',', '.')); return isNaN(v) ? null : v; }\nfunction pitLimitKph() {\n  var x = XN('PitSpeedLimitKph', 0);\n  if (x > 0) { return x; }\n  var s = '' + S('WeekendInfo.TrackPitSpeedLimit', ''), v = unitNum(s);\n  if (v === null) { return 0; }\n  return s.indexOf('mph') >= 0 ? v * 1.609344 : v;\n}\nfunction onPitRoad() { return B('IsInPitLane') || B('DataCorePlugin.GameRawData.Telemetry.OnPitRoad'); }\nvar l = pitLimitKph(); return (onPitRoad() ? 'PIT ROAD' : 'APPROACHING PIT') + (l > 0 ? '   ·   LIMIT ' + Math.round(l) + ' km/h' : '');",
