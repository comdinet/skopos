          "Name": "AIR TEMP trend",
          "RenderingSkip": 0,
          "MinimumRefreshIntervalMS": 5000.0,
          "Bindings": {
            "Text": {
              "Formula": {
                "Expression": "function N(k, d) { var v = parseFloat($prop(k)); return isNaN(v) ? d : v; }\nfunction TN(k, d) { return N('DataCorePlugin.GameRawData.Telemetry.' + k, d); }\nfunction airT() { var v = N('AirTemperature', null); return v === null ? TN('AirTemp', null) : v; }\nfunction trend(key, v, win) {\n  if (v === null || typeof root === 'undefined') { return null; }\n  var now = new Date().getTime() / 1000;\n  if (!root[key]) { root[key] = []; }\n  var a = root[key];\n  if (a.length === 0 || now - a[a.length - 1][0] >= 20) { a.push([now, v]); }\n  while (a.length > 2 && now - a[1][0] > win) { a.shift(); }\n  if (a.length < 2 || now - a[0][0] < 60) { return null; }\n  return v - a[0][1];\n}\nvar v = airT(); var d = trend('at', v, 600); if (d === null) { return 'collecting trend…'; } if (Math.abs(d) < 0.25) { return 'steady over last 10 min'; } return (d > 0 ? '▲ ' : '▼ ') + Math.abs(d).toFixed(1) + '° over last 10 min';",
                "Interpreter": 1
              },
              "Mode": 2,
              "TargetPropertyName": "Text"
            },
            "TextColor": {
              "Formula": {
                "Expression": "function N(k, d) { var v = parseFloat($prop(k)); return isNaN(v) ? d : v; }\nfunction TN(k, d) { return N('DataCorePlugin.GameRawData.Telemetry.' + k, d); }\nfunction airT() { var v = N('AirTemperature', null); return v === null ? TN('AirTemp', null) : v; }\nfunction trend(key, v, win) {\n  if (v === null || typeof root === 'undefined') { return null; }\n  var now = new Date().getTime() / 1000;\n  if (!root[key]) { root[key] = []; }\n  var a = root[key];\n  if (a.length === 0 || now - a[a.length - 1][0] >= 20) { a.push([now, v]); }\n  while (a.length > 2 && now - a[1][0] > win) { a.shift(); }\n  if (a.length < 2 || now - a[0][0] < 60) { return null; }\n  return v - a[0][1];\n}\nvar v = airT(); var d = trend('at', v, 600); if (d === null || Math.abs(d) < 0.25) { return '#FF8B95A1'; } return d > 0 ? '#FFFFC53D' : '#FF3DA5FF';",
                "Interpreter": 1
              },
              "Mode": 2,
              "TargetPropertyName": "TextColor"
            }
          }
